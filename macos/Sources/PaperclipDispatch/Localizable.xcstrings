      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escribirle al agente de una decisión, respóndele a su mensaje: le llega como comentario en la tarea. Funciona mientras esta Mac y la app estén encendidas."
          }
        }
