    "Decision": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decisión"
          }
        }
      }
    },
    "Decisions reach your phone with their buttons, so you can answer them from there. The bot is yours alone, and its token stays in this Mac’s Keychain, never in files. No public address needed: the app asks Telegram.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las decisiones te llegan al teléfono con sus botones, para contestarlas desde ahí. El bot es solo tuyo y el token queda en el llavero de esta Mac, nunca en archivos. No hace falta una dirección pública: la app le pregunta a Telegram."
          }
        }
      }
    },
    "Defer": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplazar"
          }
        }
      }
    },
    "Description:\n": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descripción:\n"
          }
        }
      }
    },
