      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo"
          }
        }
      }
    },
    "Done: Paperclip decisions reach you here, with their buttons. “Explain it to me” tells you what each one is about, and if you reply to one with text, it reaches the agent as a comment on its task.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo: aquí te llegan las decisiones de Paperclip, con sus botones. «Explícamela» te cuenta de qué se trata, y si respondes a una con texto, le llega al agente como comentario en su tarea."
          }
        }
      }
    },
