          "stringUnit": {
            "state": "translated",
            "value": "Para ver cómo se ve y si macOS lo deja pasar."
          }
        }
      }
    },
    "To see new versions here, you need the Paperclip command.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver versiones nuevas aquí hace falta el comando de Paperclip."
          }
        }
      }
