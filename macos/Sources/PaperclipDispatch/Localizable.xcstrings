        }
      }
    },
    "Dispatch %@: this app, the window you use Paperclip from.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispatch %@: esta app, la ventana desde la que usas Paperclip."
          }
        }
      }
    },
    "Dispatch notifies you only when an agent is waiting for you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispatch te avisa solo cuando un agente espera por ti."
          }
        }
      }
    },
    "Dispatch opens the Paperclip you already use.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispatch abre el Paperclip que ya usas."
          }
        }
      }
