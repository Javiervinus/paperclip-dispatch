      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Título: %@"
          }
        }
      }
    },
    "To connect this bot, open it with the link in Paperclip Settings on your Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para conectar este bot, ábrelo con el enlace de Ajustes de Paperclip en tu Mac."
          }
        }
      }
    },
    "To see how it looks and whether macOS lets it through.": {
